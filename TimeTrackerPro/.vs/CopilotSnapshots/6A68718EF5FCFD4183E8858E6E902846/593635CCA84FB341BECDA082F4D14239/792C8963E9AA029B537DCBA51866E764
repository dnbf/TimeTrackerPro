        [Fact]
        public async Task GetTimeByCategoryReportAsync_WithValidDateRange_ReturnsGroupedReport()
        {
            // Arrange
            var userId = Guid.NewGuid();
            var startDate = DateOnly.FromDateTime(DateTime.Now.AddDays(-5));
            var endDate = DateOnly.FromDateTime(DateTime.Now);

            var activities = new List<ActivityEntry>
            {
                new ActivityEntry
                {
                    Id = Guid.NewGuid(),
                    UserId = userId,
                    Date = startDate,
                    StartTime = new TimeSpan(9, 0, 0),
                    EndTime = new TimeSpan(11, 0, 0),
                    DurationMinutes = 120,
                    Category = ActivityCategory.Development,
                    Description = "Dev work"
                },
                new ActivityEntry
                {
                    Id = Guid.NewGuid(),
                    UserId = userId,
                    Date = startDate.AddDays(1),
                    StartTime = new TimeSpan(14, 0, 0),
                    EndTime = new TimeSpan(15, 30, 0),
                    DurationMinutes = 90,
                    Category = ActivityCategory.Development,
                    Description = "Dev work 2"
                },
                new ActivityEntry
                {
                    Id = Guid.NewGuid(),
                    UserId = userId,
                    Date = startDate.AddDays(1),
                    StartTime = new TimeSpan(16, 0, 0),
                    EndTime = new TimeSpan(17, 0, 0),
                    DurationMinutes = 60,
                    Category = ActivityCategory.Meeting,
                    Description = "Team meeting"
                }
            };

            var mockDbSet = new Mock<Microsoft.EntityFrameworkCore.DbSet<ActivityEntry>>();
            mockDbSet.Setup(m => m.Where(It.IsAny<System.Linq.Expressions.Expression<System.Func<ActivityEntry, bool>>>()))
                .Returns((System.Linq.Expressions.Expression<System.Func<ActivityEntry, bool>> predicate) =>
                {
                    var compiled = predicate.Compile();
                    return activities.Where(compiled).AsQueryable();
                });

            _mockDbContext.Setup(x => x.ActivityEntries).Returns(mockDbSet.Object);

            // Act
            var result = await _reportService.GetTimeByCategoryReportAsync(userId, startDate, endDate);

            // Assert
            Assert.NotNull(result);
            Assert.Equal(2, result.Count);

            var devReport = result.FirstOrDefault(r => r.Category == "Development");
            Assert.NotNull(devReport);
            Assert.Equal(210, devReport.TotalMinutes);
            Assert.Equal(3.5, devReport.TotalHours);
            Assert.Equal(2, devReport.ActivityCount);

            var meetingReport = result.FirstOrDefault(r => r.Category == "Meeting");
            Assert.NotNull(meetingReport);
            Assert.Equal(60, meetingReport.TotalMinutes);
            Assert.Equal(1.0, meetingReport.TotalHours);
            Assert.Equal(1, meetingReport.ActivityCount);
        }

