        [Fact]
        public async Task GetDailySummaryReportAsync_WithValidDateRange_ReturnsGroupedReport()
        {
            // Arrange
            var userId = Guid.NewGuid();
            var date1 = DateOnly.FromDateTime(DateTime.Now.AddDays(-2));
            var date2 = DateOnly.FromDateTime(DateTime.Now.AddDays(-1));

            var activities = new List<ActivityEntry>
            {
                new ActivityEntry
                {
                    Id = Guid.NewGuid(),
                    UserId = userId,
                    Date = date1,
                    StartTime = new TimeSpan(9, 0, 0),
                    EndTime = new TimeSpan(11, 0, 0),
                    DurationMinutes = 120,
                    Category = ActivityCategory.Development,
                    Description = "Dev work"
                },
                new ActivityEntry
                {
                    Id = Guid.NewGuid(),
                    UserId = userId,
                    Date = date1,
                    StartTime = new TimeSpan(14, 0, 0),
                    EndTime = new TimeSpan(15, 0, 0),
                    DurationMinutes = 60,
                    Category = ActivityCategory.Meeting,
                    Description = "Team meeting"
                },
                new ActivityEntry
                {
                    Id = Guid.NewGuid(),
                    UserId = userId,
                    Date = date2,
                    StartTime = new TimeSpan(9, 0, 0),
                    EndTime = new TimeSpan(12, 30, 0),
                    DurationMinutes = 210,
                    Category = ActivityCategory.Development,
                    Description = "Dev work 2"
                }
            };

            var mockDbSet = new Mock<Microsoft.EntityFrameworkCore.DbSet<ActivityEntry>>();
            mockDbSet.Setup(m => m.Where(It.IsAny<System.Linq.Expressions.Expression<System.Func<ActivityEntry, bool>>>()))
                .Returns((System.Linq.Expressions.Expression<System.Func<ActivityEntry, bool>> predicate) =>
                {
                    var compiled = predicate.Compile();
                    return activities.Where(compiled).AsQueryable();
                });

            _mockDbContext.Setup(x => x.ActivityEntries).Returns(mockDbSet.Object);

            // Act
            var result = await _reportService.GetDailySummaryReportAsync(userId, date1, date2);

            // Assert
            Assert.NotNull(result);
            Assert.Equal(2, result.Count);

            var day1Report = result.FirstOrDefault(r => r.Date == date1);
            Assert.NotNull(day1Report);
            Assert.Equal(180, day1Report.TotalMinutes);
            Assert.Equal(3.0, day1Report.TotalHours);
            Assert.Equal(2, day1Report.ActivityCount);

            var day2Report = result.FirstOrDefault(r => r.Date == date2);
            Assert.NotNull(day2Report);
            Assert.Equal(210, day2Report.TotalMinutes);
            Assert.Equal(3.5, day2Report.TotalHours);
            Assert.Equal(1, day2Report.ActivityCount);

            // Verify order (ascending by date)
            Assert.True(result[0].Date < result[1].Date);
        }

