        [Fact]
        public async Task LoginAsync_WithValidCredentials_ReturnsUserResponse()
        {
            // Arrange
            var request = new LoginRequest
            {
                Email = "joao@example.com",
                Password = "Password123"
            };

            var user = new User
            {
                Id = Guid.NewGuid(),
                Name = "João Silva",
                Email = "joao@example.com",
                PasswordHash = "hashed_password"
            };

            var mockUsers = new List<User> { user };
            var mockDbSet = new Mock<Microsoft.EntityFrameworkCore.DbSet<User>>();
            mockDbSet.Setup(m => m.FirstOrDefault(It.IsAny<System.Linq.Expressions.Expression<System.Func<User, bool>>>()))
                .Returns((System.Linq.Expressions.Expression<System.Func<User, bool>> predicate) =>
                {
                    var compiled = predicate.Compile();
                    return mockUsers.FirstOrDefault(compiled);
                });

            _mockDbContext.Setup(x => x.Users).Returns(mockDbSet.Object);

            _mockPasswordHasher.Setup(x => x.VerifyPassword(It.IsAny<string>(), It.IsAny<string>()))
                .Returns(true);

            _mockTokenService.Setup(x => x.GenerateToken(It.IsAny<User>()))
                .Returns("jwt_token");

            // Act
            var result = await _authService.LoginAsync(request);

            // Assert
            Assert.NotNull(result);
            Assert.Equal(user.Id, result.Id);
            Assert.Equal(user.Name, result.Name);
            Assert.Equal(user.Email, result.Email);
            Assert.Equal("jwt_token", result.Token);
        }

