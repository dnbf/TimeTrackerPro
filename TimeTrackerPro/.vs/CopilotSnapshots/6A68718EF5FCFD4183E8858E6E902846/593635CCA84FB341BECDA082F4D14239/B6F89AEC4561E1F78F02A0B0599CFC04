        [Fact]
        public async Task UpdateAsync_WithValidData_ReturnsUpdatedActivityResponse()
        {
            // Arrange
            var userId = Guid.NewGuid();
            var activityId = Guid.NewGuid();
            var existingActivity = new ActivityEntry
            {
                Id = activityId,
                UserId = userId,
                Date = DateOnly.FromDateTime(DateTime.Now),
                StartTime = new TimeSpan(9, 0, 0),
                EndTime = new TimeSpan(11, 0, 0),
                DurationMinutes = 120,
                Category = ActivityCategory.Development,
                Description = "Old description"
            };

            var updateRequest = new UpdateActivityEntryRequest
            {
                Date = DateOnly.FromDateTime(DateTime.Now),
                StartTime = new TimeSpan(10, 0, 0),
                EndTime = new TimeSpan(12, 30, 0),
                Category = ActivityCategory.Meeting,
                Description = "Updated description"
            };

            var mockActivities = new List<ActivityEntry> { existingActivity };
            var mockDbSet = new Mock<Microsoft.EntityFrameworkCore.DbSet<ActivityEntry>>();
            mockDbSet.Setup(m => m.FirstOrDefault(It.IsAny<System.Linq.Expressions.Expression<System.Func<ActivityEntry, bool>>>()))
                .Returns((System.Linq.Expressions.Expression<System.Func<ActivityEntry, bool>> predicate) =>
                {
                    var compiled = predicate.Compile();
                    return mockActivities.FirstOrDefault(compiled);
                });
            mockDbSet.Setup(m => m.Update(It.IsAny<ActivityEntry>()));

            _mockDbContext.Setup(x => x.ActivityEntries).Returns(mockDbSet.Object);
            _mockDbContext.Setup(x => x.SaveChangesAsync(It.IsAny<CancellationToken>()))
                .ReturnsAsync(1);

            // Act
            var result = await _activityService.UpdateAsync(userId, activityId, updateRequest);

            // Assert
            Assert.NotNull(result);
            Assert.Equal(activityId, result.Id);
            Assert.Equal(150, result.DurationMinutes); // 2.5 hours = 150 minutes
            Assert.Equal("Updated description", result.Description);
            Assert.Equal(ActivityCategory.Meeting, result.Category);
        }

