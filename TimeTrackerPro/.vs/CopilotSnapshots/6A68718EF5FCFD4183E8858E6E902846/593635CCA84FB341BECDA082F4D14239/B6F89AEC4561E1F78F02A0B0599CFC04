        [Fact]
        public async Task CreateAsync_WithValidData_ReturnsActivityResponse()
        {
            // Arrange
            var userId = Guid.NewGuid();
            var request = new CreateActivityEntryRequest
            {
                Date = DateOnly.FromDateTime(DateTime.Now),
                StartTime = new TimeSpan(9, 0, 0),
                EndTime = new TimeSpan(11, 0, 0),
                Category = ActivityCategory.Development,
                Description = "Test activity"
            };

            var mockActivities = new List<ActivityEntry>();
            var mockDbSet = new Mock<Microsoft.EntityFrameworkCore.DbSet<ActivityEntry>>();
            mockDbSet.Setup(m => m.Add(It.IsAny<ActivityEntry>()))
                .Callback<ActivityEntry>(a => mockActivities.Add(a));

            _mockDbContext.Setup(x => x.ActivityEntries).Returns(mockDbSet.Object);
            _mockDbContext.Setup(x => x.SaveChangesAsync(It.IsAny<CancellationToken>()))
                .ReturnsAsync(1);

            // Act
            var result = await _activityService.CreateAsync(userId, request);

            // Assert
            Assert.NotNull(result);
            Assert.Equal(userId, result.UserId);
            Assert.Equal(request.Date, result.Date);
            Assert.Equal(120, result.DurationMinutes);
            Assert.Equal(request.Category, result.Category);
            Assert.Equal(request.Description, result.Description);
            _mockDbContext.Verify(x => x.SaveChangesAsync(It.IsAny<CancellationToken>()), Times.Once);
        }

